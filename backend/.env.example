# Copy to .env for local dev, and set the same keys on the Railway
# "backend" and "cron" services (see the handoff instructions for which
# service needs which subset).

# Railway Postgres connection string.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/railway

# Long random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# How long a login session stays valid.
SESSION_MAX_AGE_DAYS=365

# The deployed frontend's origin (no trailing slash). Needed by the
# "backend" service only, for CORS.
FRONTEND_URL=http://localhost:3000

# From scripts/generate_vapid_keys.py. Needed by "backend" (to send the
# test push) and "cron" (to send real reminder pushes).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=info@endurance-decking.com

# MealGenie shopping-list push (Phase 2 supplies). URL is the MealGenie
# backend's origin, no trailing slash (Tada appends
# /api/shopping/external/items). The key must EQUAL the
# INTEGRATION_API_KEY env var on the MealGenie Railway service — it's
# sent as the X-API-Key header. Leave both empty to disable the
# integration. Needed by the "backend" service only.
MEALGENIE_API_URL=
MEALGENIE_API_KEY=

# In-app feedback -> a GitHub issue on the Tada repo. A fine-grained
# personal access token with Issues: write on that one repo, and the
# repo itself as "owner/repo". Leave both empty to disable in local dev
# (submissions still succeed, just without a real issue). Needed by the
# "backend" service only.
GITHUB_TOKEN=
GITHUB_REPO=

# Hearth integration (docs/hearth-integration.md). The static device
# token the Hearth wall sends as `Authorization: Bearer <token>` on the
# /api/hearth routes — it authorizes the DEVICE; the acting household
# member rides in each request. Must EQUAL the TADA_DEVICE_TOKEN env var
# on Hearth's Railway service. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable the integration (every /api/hearth route then
# returns 503). Needed by the "backend" service only.
HEARTH_DEVICE_TOKEN=
