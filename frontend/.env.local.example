# Copy to .env.local for local dev, and set the same keys on the Railway
# "frontend" service (as NEXT_PUBLIC_* build-time env vars).

# Base URL of the deployed FastAPI backend service, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Same value as the backend's VAPID_PUBLIC_KEY (see backend/.env.example).
# Generate both with backend/scripts/generate_vapid_keys.py.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
